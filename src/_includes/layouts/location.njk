---
layout: layouts/base.njk
---
{%- set loc = location -%}
{%- set pageDesc = description or ('Security guard and facility management services in ' + loc.name + ', ' + loc.state + '. ' + loc.shortDescription) -%}

<section class="page-hero page-hero-location page-hero-photo">
  <div class="hero-photo-bg" aria-hidden="true">
    {% pictureHero "location-" + loc.slug %}
  </div>
  <div class="hero-overlay" aria-hidden="true"></div>
  <div class="container">
    <p class="eyebrow">Security & Manpower Services in</p>
    <h1>{{ loc.name }}, {{ loc.state }}</h1>
    <p class="lead">{{ loc.shortDescription }}</p>
    <div class="hero-buttons">
      <button type="button" class="cta-button cta-button-primary js-open-site-visit" data-prefill-location="{{ loc.name }}">Book Free Site Visit in {{ loc.name }}</button>
      <a href="{{ site.phone.whatsapp }}?text=Hi%2C%20I%20need%20security%20services%20in%20{{ loc.name | urlencode }}" target="_blank" rel="noopener" class="cta-button-outline">WhatsApp Us</a>
    </div>
    <p class="hero-meta"><strong>Active clients in {{ loc.name }}:</strong> {{ loc.activeClients }} &nbsp;·&nbsp; <strong>Response time:</strong> {{ loc.responseTimeSLA }} &nbsp;·&nbsp; <strong>Serving since:</strong> {{ loc.established }}</p>
  </div>
</section>

<section class="container">
  <h2>Areas we cover in and around {{ loc.name }}</h2>
  <ul class="chips">
    {%- for spot in loc.landmarks -%}
    <li class="chip">{{ spot }}</li>
    {%- endfor -%}
  </ul>
</section>

<section class="container">
  <h2>Security services we provide in {{ loc.name }}</h2>
  <div class="card-grid">
    {%- for svc in services.catalog -%}
    {%- if loop.index <= 8 -%}
    <a class="card-link" href="/services/{{ svc.slug }}/">
      <div class="card">
        <div class="card-icon">{{ svc.icon }}</div>
        <h3>{{ svc.title }}</h3>
        <p>{{ svc.shortDescription }}</p>
        <p class="card-meta">From {{ svc.priceFrom }}</p>
      </div>
    </a>
    {%- endif -%}
    {%- endfor -%}
  </div>
  <p class="text-center"><a class="text-link" href="/pages/services/">See all 12 services →</a></p>
</section>

{%- if loc.slug == "siliguri" -%}
{% include "partials/location-content/siliguri.njk" %}
{%- endif -%}

{{ content | safe }}

<section class="container quote-block">
  <h2>Get a written proposal for {{ loc.name }}</h2>
  <p>Tell us about your site. We'll send a written proposal with deployment plan, pricing and SLA.</p>
  {% include "partials/quote-form.njk" %}
</section>

{% include "partials/site-visit-cta-strip.njk" %}

<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "Service",
  "serviceType": "Security and manpower services",
  "provider": { "@type": "LocalBusiness", "@id": "{{ site.url }}#localbusiness" },
  "areaServed": { "@type": "City", "name": "{{ loc.name }}", "address": { "@type": "PostalAddress", "addressLocality": "{{ loc.name }}", "addressRegion": "{{ loc.state }}", "addressCountry": "IN" } },
  "name": "Security Services in {{ loc.name }}",
  "description": "{{ loc.shortDescription }}",
  "url": "{{ site.url }}{{ page.url }}"
}
</script>
