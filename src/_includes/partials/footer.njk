<footer>
  <div class="container">
    <div class="footer-grid">
      <div>
        <img src="/assets/images/real/logo-nav.png" alt="{{ site.name }} logo" class="footer-logo" width="72" height="72" loading="lazy" decoding="async">
        <h4>{{ site.name }}</h4>
        <p>{{ site.tagline }}</p>
        <p><strong>Director:</strong> {{ site.director.name }}</p>
        <p><strong>Established:</strong> {{ site.founded }}</p>
        <p><strong>PSARA Licence:</strong> {{ site.registrations.psara }}</p>
      </div>

      <div>
        <h4>Services</h4>
        <ul class="footer-links">
          {%- for item in navigation.footer.services -%}
          <li><a href="{{ item.url }}">{{ item.label }}</a></li>
          {%- endfor -%}
        </ul>
      </div>

      <div>
        <h4>Locations</h4>
        <ul class="footer-links">
          {%- for item in navigation.footer.locations -%}
          <li><a href="{{ item.url }}">{{ item.label }}</a></li>
          {%- endfor -%}
        </ul>
      </div>

      <div>
        <h4>Company</h4>
        <ul class="footer-links">
          {%- for item in navigation.footer.company -%}
          <li><a href="{{ item.url }}">{{ item.label }}</a></li>
          {%- endfor -%}
        </ul>
      </div>

      <div>
        <h4>Get in Touch</h4>
        <p><strong>Phone:</strong> <a href="{{ site.phone.tel }}">{{ site.phone.display }}</a></p>
        <p><strong>WhatsApp:</strong> <a href="{{ site.phone.whatsapp }}" rel="noopener" target="_blank">Chat Now</a></p>
        <p><strong>Email:</strong> <a href="mailto:{{ site.email.primary }}">{{ site.email.primary }}</a></p>
        <p><strong>Office:</strong> {{ site.address.formatted }}</p>
      </div>
    </div>

    <div class="footer-bottom">
      <p>&copy; {% year %} {{ site.legalName }}. All rights reserved.</p>
      <ul class="footer-legal">
        {%- for item in navigation.footer.legal -%}
        <li><a href="{{ item.url }}">{{ item.label }}</a></li>
        {%- endfor -%}
      </ul>
    </div>
  </div>
</footer>
