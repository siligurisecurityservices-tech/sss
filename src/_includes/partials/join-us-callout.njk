<section class="join-us-callout">
  <div class="container">
    <div class="join-us-grid">
      <div class="join-us-text">
        <p class="eyebrow">We're hiring</p>
        <h2>Join our team across North Bengal, Sikkim, Kolkata, Odisha — and growing.</h2>
        <p>{{ site.stats.personnel }} teammates and growing. We're a real employer with real promotions, not a labour-supply shop.</p>
        <ul class="check-list">
          <li>Statutory benefits (EPF, ESI, bonus, gratuity) from day one</li>
          <li>Free PSARA training + ID card + basic equipment</li>
          <li>Salary on time, every month, by bank transfer</li>
          <li>Postings near home wherever possible</li>
          <li>Zero placement fees. Ever.</li>
        </ul>
        <div class="hero-buttons">
          <a href="/pages/careers/" class="cta-button cta-button-primary">See open positions</a>
          <a href="{{ site.phone.whatsapp }}?text=Hi%2C%20I%27d%20like%20to%20apply%20for%20a%20job%20at%20Siliguri%20Security%20Services" target="_blank" rel="noopener" class="cta-button-outline">WhatsApp HR</a>
        </div>
      </div>
      <div class="join-us-collage" aria-hidden="true">
        <div class="join-us-tile join-us-tile-1">{% picture "join-us-collage-1" %}</div>
        <div class="join-us-tile join-us-tile-2">{% picture "join-us-collage-2" %}</div>
        <div class="join-us-tile join-us-tile-3">{% picture "join-us-collage-3" %}</div>
      </div>
    </div>
  </div>
</section>
