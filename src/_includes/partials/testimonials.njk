{%- if testimonials.items.length > 0 -%}
<section class="container section testimonials-section">
  <header class="section-header">
    <h2>What our clients say</h2>
  </header>
  <div class="testimonial-grid">
    {%- for t in testimonials.items -%}
    <figure class="testimonial-card{% if t.placeholder %} testimonial-card-placeholder{% endif %}">
      {% if t.placeholder %}<span class="img-placeholder-badge">PLACEHOLDER · REPLACE WITH PERMISSION</span>{% endif %}
      <blockquote>“{{ t.quote }}”</blockquote>
      <figcaption>
        <strong>{{ t.name }}</strong>
        <span>{{ t.designation }}{% if t.company %}, {{ t.company }}{% endif %}</span>
        {% if t.location %}<span class="text-muted">{{ t.location }}</span>{% endif %}
      </figcaption>
    </figure>
    {%- endfor -%}
  </div>
</section>

{%- set realTestimonials = testimonials.items | rejectattr("placeholder") | list -%}
{%- if realTestimonials.length > 0 -%}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "Organization",
  "name": "{{ site.name }}",
  "url": "{{ site.url }}",
  "review": [
    {%- for t in realTestimonials -%}
    {
      "@type": "Review",
      "author": { "@type": "Person", "name": {{ t.name | jsonify }} },
      "reviewBody": {{ t.quote | jsonify }},
      "reviewRating": { "@type": "Rating", "ratingValue": 5, "bestRating": 5 },
      "itemReviewed": { "@type": "Organization", "name": "{{ site.name }}" }
    }{% if not loop.last %},{% endif %}
    {%- endfor -%}
  ],
  "aggregateRating": {
    "@type": "AggregateRating",
    "ratingValue": "4.9",
    "reviewCount": "{{ realTestimonials.length }}",
    "bestRating": 5
  }
}
</script>
{%- endif -%}
{%- endif -%}
