{# Breadcrumbs computed in services.11tydata.js to work correctly with pagination #}

<section class="container">
  <h2>What's included</h2>
  <ul class="check-list">
    <li>PSARA-licensed agency, fully insured, with statutory compliance built into every contract.</li>
    <li>21-day induction training plus role-specific briefing for {{ service.title | lower }}.</li>
    <li>Supervisor visits, replacement guarantee within the SLA, and a single point of contact for escalations.</li>
    <li>Monthly compliance reporting (EPF / ESI challans on request) and incident log access.</li>
    <li>Optional add-ons: CCTV monitoring, mobile patrol backup, K9 unit, female frisking, executive protection.</li>
  </ul>
</section>

<section class="container">
  <h2>Who this is for</h2>
  <p>{{ service.shortDescription }} Whether you operate a single site in Siliguri or a multi-state enterprise footprint, our deployment model scales — start small, grow as you need.</p>
</section>

<section class="container">
  <h2>Deployment process</h2>
  <ol class="steps">
    <li><strong>Site visit (free, no obligation).</strong> Our supervisor visits, assesses risk, walks the perimeter and meets your facility manager.</li>
    <li><strong>Proposal in 24 hours.</strong> Written deployment plan, guard count, shift pattern, equipment, pricing and SLA.</li>
    <li><strong>Contract & onboarding.</strong> Agreement signed, statutory paperwork completed, induction scheduled.</li>
    <li><strong>Deployment in 24–72 hours.</strong> Trained guards on post with full PSARA paperwork in place.</li>
    <li><strong>Ongoing supervision.</strong> Supervisor visits, monthly review, transparent compliance reporting.</li>
  </ol>
</section>

<section class="container">
  <h2>Available across our coverage area</h2>
  <p>This service is deployed in all {{ locations.catalog.length }} of our established markets:</p>
  <ul class="chips">
    {%- for loc in locations.catalog -%}
    <li class="chip"><a href="/locations/{{ loc.slug }}/">{{ loc.name }}</a></li>
    {%- endfor -%}
  </ul>
</section>
