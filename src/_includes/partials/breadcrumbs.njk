<nav class="breadcrumbs" aria-label="Breadcrumb">
  <div class="container">
    <ol>
      {%- for crumb in breadcrumbs -%}
      <li>
        {%- if not loop.last -%}
        <a href="{{ crumb.url }}">{{ crumb.label }}</a>
        {%- else -%}
        <span aria-current="page">{{ crumb.label }}</span>
        {%- endif -%}
      </li>
      {%- endfor -%}
    </ol>
  </div>
</nav>
