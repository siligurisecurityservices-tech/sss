  "description": "Hire temporary guards or darwan for 1, 2, 3, 4 or a few days around Matigara, Gossainpur, Patharghata, Salbari, Naxalbari and Bagdogra. Request a local quote.",
  "temporaryQuote": true,
  "temporaryService": "Temporary Security — Guards and Darwan",
  "hero": {
    "title": "Temporary security guards and darwan near Matigara",
    "subtitle": "Local guards for short-term requirements around Matigara: weddings, puja pandals, home guarding during travel and other agreed duties.",
    "cta": {
      "label": "Request a short-term guard quote",
      "url": "#temporary-quote"
    }
  },
  "breadcrumbs": [
    {
      "label": "Home",
      "url": "/"
    },
    {
      "label": "Services",
