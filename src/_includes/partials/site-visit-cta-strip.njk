<section class="site-visit-strip">
  <div class="container">
    <div class="strip-content">
      <div>
        <h2>Free Site Visit, no obligation</h2>
        <p>A supervisor will visit, assess your site and email a proposal — usually within 24 hours.</p>
      </div>
      <div class="strip-actions">
        <button type="button" class="cta-button cta-button-white js-open-site-visit">Book Free Site Visit</button>
        <a href="{{ site.phone.tel }}" class="cta-button-outline-white">Call {{ site.phone.display }}</a>
      </div>
    </div>
  </div>
</section>
