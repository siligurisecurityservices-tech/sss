<section class="container section">
  <header class="section-header">
    <h2>See us in action</h2>
    <p>Posts, training, operations and patrol — across our coverage area. <span class="text-muted">(Click any photo to enlarge.)</span></p>
  </header>
  <ul class="photo-grid">
    {%- set galleryItems = [
      { key: "gallery-1", caption: "Gatehouse access control" },
      { key: "gallery-2", caption: "Hotel lobby reception" },
      { key: "gallery-3", caption: "Training session in progress" },
      { key: "gallery-4", caption: "Control room monitoring" },
      { key: "gallery-5", caption: "Patrol vehicle on the move" },
      { key: "gallery-6", caption: "Hospital frisking station" }
    ] -%}
    {%- for item in galleryItems -%}
    <li>
      <button type="button" class="photo-grid-tile js-open-lightbox" data-index="{{ loop.index0 }}" aria-label="Open photo: {{ item.caption }}">
        {% picture item.key, "(max-width: 640px) 50vw, 33vw" %}
        <span class="photo-grid-caption">{{ item.caption }}</span>
      </button>
    </li>
    {%- endfor -%}
  </ul>
</section>

<div id="lightbox" class="lightbox" role="dialog" aria-modal="true" aria-label="Photo viewer" hidden>
  <button type="button" class="lightbox-close js-close-lightbox" aria-label="Close">×</button>
  <button type="button" class="lightbox-prev js-prev-lightbox" aria-label="Previous photo">‹</button>
  <button type="button" class="lightbox-next js-next-lightbox" aria-label="Next photo">›</button>
  <div class="lightbox-stage">
    <img id="lightbox-img" src="" alt="">
    <p id="lightbox-caption" class="lightbox-caption"></p>
  </div>
</div>
