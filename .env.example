# Copy to .env.local for local development. Set the same vars in Vercel for production.

# Email delivery (https://resend.com)
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
LEAD_FROM_EMAIL=leads@siligurisecurityservices.com
LEAD_NOTIFY_EMAIL=siliguri.security.services@gmail.com
# Optional separate inbox for career applications. Falls back to LEAD_NOTIFY_EMAIL if unset.
LEAD_CAREER_NOTIFY_EMAIL=hr@siligurisisecurity.com

# Cloudflare Turnstile anti-bot (https://www.cloudflare.com/products/turnstile/)
# Frontend uses NEXT_PUBLIC_TURNSTILE_SITEKEY in <div class="cf-turnstile" data-sitekey="..."></div>.
# We currently inject sitekey "0x0000000000000000000000" as a placeholder — replace it in
# src/_includes/partials/{quote-form,site-visit-form}.njk with your real sitekey.
TURNSTILE_SITEKEY=0x4AAAAAAAxxxxxxxxxxxxxx
TURNSTILE_SECRET=0x4AAAAAAAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Allowed CORS origin (production domain). Use * for development only.
ALLOWED_ORIGIN=https://www.siligurisisecurity.com
